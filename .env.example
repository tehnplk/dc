DATABASE_URL="postgresql://dc:dc@localhost:5436/dc?schema=public"
TZ="Asia/Bangkok"

# PLKHealth SSO — https://sso.plkhealth.go.th/llm.txt
SSO_ISSUER="https://sso.plkhealth.go.th"
SSO_CLIENT_ID=""
SSO_CLIENT_SECRET=""
# ต้องตรงกับ Redirect URI ที่ลงทะเบียนไว้กับ SSO (callback = $APP_URL/auth/callback)
SSO_SCOPES="openid profile email organization"
APP_URL="http://localhost:3000"
# สุ่มเอง เช่น: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=""

# บัญชีผู้ดูแลสำรอง เข้าที่ /auth/admin ได้โดยไม่ผ่าน SSO (ไว้กู้ระบบตอน SSO ล่ม/ยังไม่มี admin)
# เว้นว่าง = ปิดทางเข้านี้ไปเลย
SUPER_USER=""
SUPER_USER_PASSWORD=""
# หน่วยงานที่ผูกให้บัญชีนี้ (ต้องมีใน c_org) ไม่ตั้ง = 00051 สสจ.พิษณุโลก
SUPER_USER_ORG="00051"
