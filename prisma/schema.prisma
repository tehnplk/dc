/// materialized view — prisma db pull มองไม่เห็น postpull.mjs เติมกลับให้
/// REFRESH MATERIALIZED VIEW CONCURRENTLY mv_case_daily;
view mv_case_daily {
  disease_code String
  date_onset   DateTime @db.Date
  prov_code    String?
  amp_code     String?
  tmb_code     String?
  moo_code     String
  cases        BigInt
  deaths       BigInt
  controlled   BigInt
  cases_child  BigInt

  @@unique([disease_code, date_onset, moo_code])
}
